@model List<Trail_A.Models.VehicleType>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<form asp-action="Index" method="get">
    <input type="text" name="Name" />
    <button type="submit">Search</button>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                VehicleName
            </th>
            <th>
                BaseFare
            </th>
            <th>
                user
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.VehicleName
            </td>
            <td>
                @item.BaseFare
            </td>
            <td>
                @item.CreatedByUserId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.VehicleTypeId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.VehicleTypeId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.VehicleTypeId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
