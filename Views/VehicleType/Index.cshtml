@model List<Trail_A.Models.VehicleType>

<h2>VehicleTypes</h2>

<form asp-action="Index" method="get">
    <input type="text" name="Name" />
    <button type="submit">Search</button>
</form>

<a asp-action="Create">Create New</a>

<table class="table">
    <thead>
        <tr>
            <th>VehicleName</th>
            <th>BaseFare</th>
            <th>CreatedByUserId</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VehicleName</td>
                <td>@item.BaseFare</td>
                <td>@item.CreatedByUserId</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.VehicleTypeId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.VehicleTypeId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.VehicleTypeId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
