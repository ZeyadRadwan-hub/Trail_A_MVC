@model Trail_A.View_Model.VehicleTypeViewModel

<h2>Create VehicleType</h2>

<form asp-action="Create" method="post" class="form-group">
    <div class="form-group">
        <label asp-for="VehicleName"></label>
        <input asp-for="VehicleName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="BaseFare"></label>
        <input asp-for="BaseFare" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="CreatedByUserId"></label>
        <select asp-for="CreatedByUserId" class="form-control">
            @foreach (var item in Model.users)
            {
                <option value="@item.UserId">@item.UserId</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>
