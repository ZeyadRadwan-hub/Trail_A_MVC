@model Trail_A.Models.VehicleType

<h1>VehicleType Details</h1>
<table class="table">
    <thead>
        <tr>
            <th>VehicleName</th>
            <th>BaseFare</th>
            <th>Created By</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.VehicleName</td>
            <td>@Model.BaseFare</td>
            <td>@(Model.user?.EmailAddress)</td>
        </tr>
    </tbody>
</table>
