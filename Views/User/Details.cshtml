@model Trail_A.Models.User

<h1>User Details</h1>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>EmailAddress</th>
            <th>Password</th>
            <th>Phone</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Name</td>
            <td>@Model.EmailAddress</td>
            <td>********</td>
            <td>@Model.Phone</td>
            <td>@Model.Role</td>
        </tr>
    </tbody>
</table>
