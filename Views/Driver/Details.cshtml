@model Trail_A.Models.Driver

<h1>Driver Details</h1>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>LicenseNumber</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Created By</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Name</td>
            <td>@Model.LicenseNumber</td>
            <td>@Model.Phone</td>
            <td>@Model.Status</td>
            <td>@(Model.user?.EmailAddress)</td>
        </tr>
    </tbody>
</table>
