@model Trail_A.View_Model.DriverViewModel

<h2>Create Driver</h2>

<form asp-action="Create" method="post" class="form-group">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="LicenseNumber"></label>
        <input asp-for="LicenseNumber" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Status"></label>
        <input asp-for="Status" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="CreatedByUserId"></label>
        <select asp-for="CreatedByUserId" class="form-control">
            @foreach (var item in Model.users)
            {
                <option value="@item.UserId">@item.UserId</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>
