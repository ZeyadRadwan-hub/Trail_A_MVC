@model Trail_A.Models.Ride

<h1>Ride Details</h1>
<table class="table">
    <thead>
        <tr>
            <th>PickUp</th>
            <th>PickOff</th>
            <th>Fare</th>
            <th>Status</th>
            <th>Date</th>
            <th>Driver</th>
            <th>Vehicle Type</th>
            <th>User</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.PickUp</td>
            <td>@Model.PickOff</td>
            <td>@Model.Fare</td>
            <td>@Model.Status</td>
            <td>@Model.Date</td>
            <td>@(Model.driver?.LicenseNumber)</td>
            <td>@(Model.vehicleType?.VehicleName)</td>
            <td>@(Model.user?.EmailAddress)</td>
        </tr>
    </tbody>
</table>
