@model Trail_A.View_Model.RideViewModel

<h2>Create Ride</h2>

<form asp-action="Create" method="post" class="form-group">
    <div class="form-group">
        <label asp-for="PickUp"></label>
        <input asp-for="PickUp" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PickOff"></label>
        <input asp-for="PickOff" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Fare"></label>
        <input asp-for="Fare" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Status"></label>
        <input asp-for="Status" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="DriverId"></label>
        <select asp-for="DriverId" class="form-control">
            @foreach (var item in Model.drivers)
            {
                <option value="@item.DriverId">@item.DriverId</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label asp-for="VehicleId"></label>
        <select asp-for="VehicleId" class="form-control">
            @foreach (var item in Model.vehicleTypes)
            {
                <option value="@item.VehicleTypeId">@item.VehicleTypeId</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label asp-for="UserId"></label>
        <select asp-for="UserId" class="form-control">
            @foreach (var item in Model.users)
            {
                <option value="@item.UserId">@item.UserId</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>
