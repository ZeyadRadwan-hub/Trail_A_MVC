@model List<Trail_A.Models.Ride>

<h2>Rides</h2>

<form asp-action="Index" method="get">
    <input type="text" name="Name" />
    <button type="submit">Search</button>
</form>

<a asp-action="Create">Create New</a>

<table class="table">
    <thead>
        <tr>
            <th>RideId</th>
            <th>PickUp</th>
            <th>PickOff</th>
            <th>Date</th>
            <th>Fare</th>
            <th>Status</th>
            <th>DriverId</th>
            <th>VehicleId</th>
            <th>UserId</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RideId</td>
                <td>@item.PickUp</td>
                <td>@item.PickOff</td>
                <td>@item.Date</td>
                <td>@item.Fare</td>
                <td>@item.Status</td>
                <td>@item.DriverId</td>
                <td>@item.VehicleId</td>
                <td>@item.UserId</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.RideId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.RideId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.RideId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
